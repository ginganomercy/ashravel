{
    "name": "ashravel/turboblade",
    "description": "Zero-JS Single Page Application (SPA) functionality for Laravel Blade.",
    "keywords": ["laravel", "spa", "pjax", "livewire", "inertia", "turboblade", "blade"],
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Rafly A.R",
            "email": "raflypriyantoro@gmail.com"
        }
    ],
    "require": {
        "php": "^8.0",
        "illuminate/support": "^9.0|^10.0|^11.0|^12.0",
        "illuminate/view": "^9.0|^10.0|^11.0|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Ashravel\\TurboBlade\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ashravel\\TurboBlade\\TurboBladeServiceProvider"
            ]
        }
    }
}
