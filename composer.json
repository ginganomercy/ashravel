{
    "name": "ashravel/turboblade",
    "description": "Zero-JS Single Page Application (SPA) functionality for Laravel Blade.",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "Ashravel Architect",
            "email": "architect@ashravel.com"
        }
    ],
    "require": {
        "php": "^8.1",
        "illuminate/support": "^10.0|^11.0",
        "illuminate/view": "^10.0|^11.0"
    },
    "autoload": {
        "psr-4": {
            "Ashravel\\TurboBlade\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Ashravel\\TurboBlade\\TurboBladeServiceProvider"
            ]
        }
    }
